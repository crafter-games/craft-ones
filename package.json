{
  "name": "craft-ones",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@craft-ones/web' --filter '@craft-ones/game-server' dev",
    "dev:web": "bun run --filter '@craft-ones/web' dev",
    "dev:server": "bun run --filter '@craft-ones/game-server' dev",
    "build": "bun run --filter '@craft-ones/web' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test apps/game-server",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
