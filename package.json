{
  "name": "craft-ones",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "nanoid": "3.3.18"
  },
  "scripts": {
    "dev": "bun run --parallel --filter '@craft-ones/web' --filter '@craft-ones/game-server' dev",
    "dev:web": "bun run --filter '@craft-ones/web' dev",
    "dev:server": "bun run --filter '@craft-ones/game-server' dev",
    "build": "bun run build:server && bun run --filter '@craft-ones/web' build",
    "build:server": "NODE_ENV=production bun build apps/game-server/src/index.ts --target=node --external msgpackr-extract --external bufferutil --external utf-8-validate --outfile=dist/game-server.mjs",
    "start:server": "node dist/game-server.mjs",
    "test:e2e:dev": "E2E_DEV=1 playwright test production.spec.ts exclusives.spec.ts",
    "test:server:bundle": "TEST_SERVER_BUNDLE=1 bun test apps/game-server/src/server.test.ts apps/game-server/src/security.test.ts",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p tests/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test apps/game-server",
    "test:e2e": "playwright test",
    "test:load": "bun scripts/load.ts",
    "test:container": "bash scripts/container-smoke.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "colyseus.js": "0.16.22",
    "typescript": "5.9.3"
  },
  "patchedDependencies": {
    "@colyseus/core@0.16.24": "patches/@colyseus%2Fcore@0.16.24.patch"
  }
}
