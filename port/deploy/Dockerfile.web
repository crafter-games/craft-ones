# Static web build of craft-ones, served by nginx. Generated by dotframe deploy init; edit freely.
FROM oven/bun:1.3.11 AS build
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN cd port && bun install --frozen-lockfile && bun node_modules/dotframe/cli/main.ts build web

FROM nginx:1.27-alpine
COPY port/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/port/dist/web /usr/share/nginx/html
EXPOSE 80
