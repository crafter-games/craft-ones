# Static web build of the dotframe port, served by nginx.
FROM oven/bun:1.3.11 AS build
WORKDIR /app
COPY packages/shared ./packages/shared
COPY assets/brand ./assets/brand
COPY port/package.json port/bun.lock ./port/
RUN cd port && bun install --frozen-lockfile
COPY port ./port
RUN cd port && rm -rf assets/art assets/sfx dist && sh scripts/build-web.sh

FROM nginx:1.27-alpine
COPY port/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/port/dist/web /usr/share/nginx/html
EXPOSE 80
